    "@upstash/redis": "^1.35.3",
    "@webrizen/sso": "^0.1.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lenis": "^1.3.26",
    "next": "16.3.7",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.2.8",
    "rehype-pretty-code": "^0.14.5",
