# Public URL of this app, no trailing slash. Use 127.0.0.1 locally so cookies stay
# separate from a local Webrizen SSO server on localhost:3000.
APP_URL=http://127.0.0.1:3001

# Postgres. Local: `pnpm db:local`. Vercel: Neon pooled URL (…-pooler…/db?sslmode=require)
DATABASE_URL=postgres://chronon:chronon@localhost:54321/chronon

# Webrizen SSO (sign-in for the dashboard). Register Chronon in Webrizen SSO →
# Platform admin → Applications → Register application, with
#   Redirect URI:        {APP_URL}/api/auth/webrizen/callback
#   Sign-out redirect:   {APP_URL}
# Leave these empty to work on the API only (create keys with `pnpm dev:key`).
WEBRIZEN_SSO_ISSUER=http://localhost:3000/api/auth
WEBRIZEN_SSO_CLIENT_ID=
WEBRIZEN_SSO_CLIENT_SECRET=
# Any random string of 32+ characters: openssl rand -base64 32
WEBRIZEN_SSO_SESSION_SECRET=

# Upstash Redis for rate limits shared across serverless instances (free tier is plenty).
# Leave empty locally to use in-memory limits. KV_REST_API_URL / KV_REST_API_TOKEN (what the
# Vercel Marketplace integration injects) work too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated emails (verified in Webrizen SSO) that can open /dashboard/admin.
CHRONON_ADMIN_EMAILS=

# Repository link shown on the site.
NEXT_PUBLIC_REPO_URL=https://github.com/webrizen-ai-labs-pvt-ltd/chronon
